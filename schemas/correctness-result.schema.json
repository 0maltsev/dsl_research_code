{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundfin.example/schemas/correctness-result.schema.json",
  "title": "BoundFin correctness result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "created_at",
    "status",
    "failure_status",
    "failure_detail",
    "diagnostic_codes",
    "configuration_id",
    "dataset_id",
    "seed",
    "toolchain_versions",
    "test_family",
    "case_id",
    "rule_ids",
    "proof_obligations",
    "source_sha256",
    "input_sha256",
    "input_bytes",
    "expected",
    "observations",
    "static_bounds",
    "comparison",
    "gate",
    "artifact_checksums"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail", "unresolved"] },
    "failure_status": { "$ref": "#/$defs/nullableFailure" },
    "failure_detail": { "type": ["string", "null"] },
    "diagnostic_codes": { "type": "array", "items": { "$ref": "#/$defs/diagnosticCode" }, "uniqueItems": true },
    "configuration_id": { "$ref": "#/$defs/id" },
    "dataset_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "seed": { "type": ["string", "integer", "null"] },
    "toolchain_versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "test_family": {
      "enum": [
        "lexical", "syntax", "name_resolution", "typing", "size_count",
        "effect", "numeric", "evaluation_rule", "cost_trace", "footprint",
        "abi", "bir_validation", "bir_evaluation", "wasm_validation",
        "conformance", "generated", "property", "metamorphic", "differential",
        "translation_validation", "frame_reuse", "address_boundary", "simd_variant"
      ]
    },
    "case_id": { "$ref": "#/$defs/id" },
    "rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "proof_obligations": { "type": "array", "items": { "type": "string", "pattern": "^(TH|LEM|PO)-[A-Z0-9-]+$" }, "uniqueItems": true },
    "source_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "input_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "input_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "expected": { "$ref": "#/$defs/outcome" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["implementation", "artifact_id", "outcome", "raw_result_sha256", "normalized_result_sha256", "trace_sha256", "dynamic_cost", "fault", "diagnostic_codes"],
        "properties": {
          "implementation": { "enum": ["lexer", "parser", "checker", "reference", "bir", "wasm", "native", "simd_wasm", "simd_native"] },
          "artifact_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "outcome": { "$ref": "#/$defs/outcome" },
          "raw_result_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "normalized_result_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "trace_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "dynamic_cost": { "oneOf": [{ "$ref": "#/$defs/dynamicCost" }, { "type": "null" }] },
          "fault": { "type": ["string", "null"], "enum": [null, "badControl", "badType", "badCap", "uninit", "oob", "stackExhaust", "wasm_trap", "host_failure"] },
          "diagnostic_codes": { "type": "array", "items": { "$ref": "#/$defs/diagnosticCode" }, "uniqueItems": true }
        }
      }
    },
    "static_bounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "bound", "result_footprint_bytes", "certificate_sha256"],
        "properties": {
          "mode": { "enum": ["exact", "symbolic_upper", "capacity_only"] },
          "bound": { "$ref": "#/$defs/dynamicCost" },
          "result_footprint_bytes": { "type": "integer", "minimum": 0 },
          "certificate_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_match", "first_error_match", "trace_match", "bound_violations", "slack", "notes"],
      "properties": {
        "observable_match": { "type": ["boolean", "null"] },
        "first_error_match": { "type": ["boolean", "null"] },
        "trace_match": { "type": ["boolean", "null"] },
        "bound_violations": {
          "type": "array",
          "items": { "enum": ["operations", "allocations", "reserved_bytes", "peak_live_bytes", "read_bytes", "written_bytes", "decisions", "call_depth", "result_footprint_bytes"] },
          "uniqueItems": true
        },
        "slack": {
          "type": "object",
          "additionalProperties": { "type": ["number", "null"] },
          "propertyNames": { "enum": ["operations", "allocations", "reserved_bytes", "peak_live_bytes", "read_bytes", "written_bytes", "decisions", "call_depth", "result_footprint_bytes"] }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "outcome", "blocks_performance", "formal_status"],
      "properties": {
        "gate_id": { "enum": ["G1", "G2", "SIMD", "none"] },
        "outcome": { "enum": ["counterexample_detected", "mismatch_or_fault_detected", "none_detected_in_declared_domain", "unresolved", "not_applicable"] },
        "blocks_performance": { "type": "boolean" },
        "formal_status": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_checksums": { "$ref": "#/$defs/checksums" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "diagnosticCode": { "type": "string", "pattern": "^(LEX|SYN|NAM|TYP|SIZ|EFF|CST|BIR|ABI|WASM|INT|RUN)[0-9]{3}$" },
    "nullableFailure": {
      "type": ["string", "null"],
      "enum": [null, "source_rejected", "abi_rejected", "bir_rejected", "wasm_rejected", "bir_fault", "wasm_trap", "resource_exhaustion", "host_failure", "backend_failure", "os_termination", "hardware_failure", "mismatch", "checksum_failure", "environment_invalid", "counter_failure", "incomplete"]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status_word", "status_name", "type", "value_summary"],
      "properties": {
        "kind": { "enum": ["success", "declared_error", "invalid_abi", "source_rejection", "validator_rejection", "target_fault", "not_applicable"] },
        "status_word": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
        "status_name": { "type": ["string", "null"], "enum": [null, "Success", "Bounds", "DivZero", "DivOverflow", "InvalidABI"] },
        "type": { "type": ["string", "null"] },
        "value_summary": { "type": ["string", "number", "integer", "boolean", "object", "array", "null"] }
      }
    },
    "dynamicCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "allocations", "reserved_bytes", "peak_live_bytes", "read_bytes", "written_bytes", "decisions", "call_depth", "units"],
      "properties": {
        "operations": { "type": "integer", "minimum": 0 },
        "allocations": { "type": "integer", "minimum": 0 },
        "reserved_bytes": { "type": "integer", "minimum": 0 },
        "peak_live_bytes": { "type": "integer", "minimum": 0 },
        "read_bytes": { "type": "integer", "minimum": 0 },
        "written_bytes": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "call_depth": { "type": "integer", "minimum": 1 },
        "units": { "const": "source_events_and_bytes" }
      }
    },
    "checksums": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    }
  }
}

